# ──────────────────────────────────────────────
# Firebase Client SDK (public, safe to expose)
# ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ──────────────────────────────────────────────
# Firebase Admin SDK (server-side only, SECRET)
# In production: managed via Google Secret Manager
# In development: set these in .env
# ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ──────────────────────────────────────────────
# SendGrid (email delivery)
# ──────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aprendeswift.dev
SENDGRID_FROM_NAME=aprendeSwift
CONTACT_EMAIL=contacto@aprendeswift.dev

# ──────────────────────────────────────────────
# OpenAI (SEO generation)
# ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
